{
  "name": "shadowsurf",
  "version": "0.1.0",
  "private": true,
  "description": "ShadowSurf — AI 原生浏览器，人机双轨的 Agent 工作台",
  "license": "MIT",
  "main": "out/main/index.js",
  "author": "Violet Notes",
  "scripts": {
    "dev": "node tools/launch.mjs dev",
    "build": "electron-vite build",
    "start": "node tools/launch.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "mock": "node tools/mock-llm.mjs",
    "shot": "node tools/shot-prototype.mjs",
    "test": "node tools/run-tests.mjs",
    "verify:injection": "node tools/check-injection.mjs && node tools/run-electron.mjs tools/probe-mask.cjs && node tools/run-electron.mjs tools/probe-worker.cjs",
    "verify:gate": "node tools/probe-gate.mjs",
    "verify:consent": "node tools/probe-consent.mjs",
    "verify:anticheat": "node tools/check-build-fresh.mjs && node tools/verify-anticheat.mjs",
    "verify:anticheat:nightly": "node tools/check-build-fresh.mjs && node tools/verify-anticheat.mjs --nightly",
    "check": "npm run typecheck && npm run test",
    "preverify:injection": "electron-vite build",
    "preverify:anticheat": "electron-vite build",
    "preverify:anticheat:nightly": "electron-vite build",
    "verify:anticheat:stale": "node tools/check-build-fresh.mjs --allow-stale && node tools/verify-anticheat.mjs",
    "verify:seed-at-rest": "node tools/verify-seed-at-rest.mjs --self-test && node tools/verify-seed-at-rest.mjs",
    "verify:all": "npm run typecheck && npm run build && npm run test:gate && npm run verify:seed-at-rest && npm run verify:seed-ipc && npm run verify:mask-ui && npm run verify:mask-exemption && npm run verify:injection && npm run verify:worker && npm run verify:shared-worker && npm run verify:fonts && npm run verify:theme && npm run verify:share && npm run verify:uach && npm run verify:anticheat",
    "test:gate": "node tools/run-tests.mjs --gate",
    "verify:worker": "node tools/verify-worker-inject.mjs",
    "preverify:worker": "electron-vite build",
    "verify:shared-worker": "node tools/verify-shared-worker-inject.mjs",
    "preverify:shared-worker": "electron-vite build",
    "verify:seed-ipc": "node tools/verify-seed-ipc.mjs",
    "preverify:seed-ipc": "electron-vite build",
    "verify:mask-ui": "node --experimental-strip-types tools/verify-mask-ui.mjs",
    "preverify:mask-ui": "electron-vite build",
    "verify:mask-exemption": "node tools/verify-mask-exemption.mjs",
    "preverify:mask-exemption": "electron-vite build",
    "probe:tostring": "node tools/run-electron.mjs tools/probe-tostring.mjs",
    "probe:shared-worker": "node tools/run-electron.mjs tools/probe-shared-worker.mjs",
    "verify:uach": "node tools/verify-uach.mjs",
    "preverify:uach": "electron-vite build",
    "verify:fonts": "node tools/verify-fonts.mjs",
    "preverify:fonts": "electron-vite build",
    "audit:creepjs": "node tools/audit-creepjs.mjs --full",
    "icons": "node tools/gen-icons.mjs",
    "verify:theme": "node tools/verify-theme.mjs",
    "preverify:theme": "electron-vite build",
    "verify:share": "node tools/verify-share.mjs",
    "preverify:share": "electron-vite build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
